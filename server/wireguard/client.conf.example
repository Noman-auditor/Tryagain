# NORA TUNNEL - Client Config Example
# Import via App: Import .conf or QR Scanner
# This file is generated by server/scripts/generate-client.sh

[Interface]
PrivateKey = <CLIENT_PRIVATE_KEY>
Address = 10.8.0.2/32, fd86:ea04:1111::2/128
DNS = 10.8.0.1, 1.1.1.1
MTU = 1280

[Peer]
PublicKey = <SERVER_PUBLIC_KEY>
PresharedKey = <PRESHARED_KEY_IF_USED>
Endpoint = YOUR_VPS_IP:51820
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
# For split-tunnel use: AllowedIPs = 10.8.0.0/24, 192.168.1.0/24
