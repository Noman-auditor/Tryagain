# NORA TUNNEL - Server Config Example
# Path on VPS: /etc/wireguard/wg0.conf
# Generate keys: wg genkey | tee private.key | wg pubkey > public.key

[Interface]
PrivateKey = <SERVER_PRIVATE_KEY_GENERATED_BY_wg_genkey>
Address = 10.8.0.1/24, fd86:ea04:1111::1/64
ListenPort = 51820
SaveConfig = false
# NAT - WAN_INTERFACE is auto-detected by install-wireguard.sh
# Do NOT hardcode eth0 - script replaces $WAN_INTERFACE
PostUp = iptables -A FORWARD -i %i -j ACCEPT; iptables -t nat -A POSTROUTING -o %i -j MASQUERADE; ip6tables -A FORWARD -i %i -j ACCEPT; ip6tables -t nat -A POSTROUTING -o %i -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -j ACCEPT; iptables -t nat -D POSTROUTING -o %i -j MASQUERADE; ip6tables -D FORWARD -i %i -j ACCEPT; ip6tables -t nat -D POSTROUTING -o %i -j MASQUERADE

[Peer]
# 🇸🇬 Singapore - Client 1 Example
PublicKey = <CLIENT_PUBLIC_KEY>
PresharedKey = <OPTIONAL_PRESHARED_KEY>
AllowedIPs = 10.8.0.2/32, fd86:ea04:1111::2/128

# [Peer]
# 🇩🇪 Germany - Client 2 Example
# PublicKey = <CLIENT2_PUBLIC_KEY>
# AllowedIPs = 10.8.0.3/32, fd86:ea04:1111::3/128
